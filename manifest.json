{
  "manifest_version": 3,
  "name": "Moodle Bulk Downloader",
  "version": "2.0.0",
  "description": "Download all study materials from a Moodle course page in one click.",

  "permissions": [
    "downloads",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "notifications",
    "contextMenus"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "options_page": "options.html",

  "web_accessible_resources": [
    {
      "resources": ["jszip.min.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "moodle-bulk-downloader@trishan",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
